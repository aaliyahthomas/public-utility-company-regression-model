      "source": [
        "# Now I am creating the winter dummy variables, by focusing on months december, january and february (12, 1, 2)\n",
        "HS_data['winter_DV'] = np.where(HS_data['date'].dt.month.isin([12,1,2]),1,0)\n",
        "\n",
        "# Now I am creating the fall dummy variables, by focusing on months september, october and november (9, 10 ,11)\n",
        "HS_data['fall_DV'] = np.where(HS_data['date'].dt.month.isin([9,10,11]),1,0)\n"
      ],
      "metadata": {
        "id": "47Q1YafvH_no"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# now I am creating the interaction terms for both fall and winter dummy variables, the interaction term is just the dummy variable multiplied by our independent variable in this case I am choosing to focus on production\n",
        "HS_data['winter_interaction'] = HS_data['production'] * HS_data['winter_DV']\n",
        "\n",
        "HS_data['fall_interaction'] = HS_data['production'] * HS_data['fall_DV']"
      ],
